# Vercel Blob store token — lets coaches upload routine videos directly from the browser
BLOB_READ_WRITE_TOKEN=
# Resend API key — sends the intake notification email
RESEND_API_KEY=
# Where intake submissions are delivered (the client's inbox)
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Polish The Score <critiques@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Public site URL, used for social share images
NEXT_PUBLIC_SITE_URL=
